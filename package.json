{
  "name": "snapdock",
  "version": "3.3.1",
  "description": "A Minimal, Modern Markdown Editor",
  "synopsis": "Fast, clean Markdown editor",
  "homepage": "https://snapdock.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZFordDev/SnapDock"
  },
  "author": "ZFordDev",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "npm run tauri:dev",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "bundle": "node scripts/bundle.js && npm run css:build",
    "css:build": "tailwindcss -i ./src/styles/tailwind.css -o ./dist/styles.css --minify",
    "css:watch": "tailwindcss -i ./src/styles/tailwind.css -o ./dist/styles.css --watch",
    "typecheck": "tsc -p tsconfig.renderer.json && tsc -p tsconfig.node.json && tsc -p tsconfig.test.json",
    "test": "tsx --test test/markdown-render.test.ts src/modules/ui/editorFont.test.ts tests/find.test.ts tests/link-navigation.test.ts && node tests/layout-regressions.test.js",
    "md:test": "tsx --test test/markdown-render.test.ts",
    "verify": "npm run typecheck && npm test && npm run bundle",
    "build:test": "npm run verify && tauri build --debug",
    "build:release": "npm run verify && tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.9",
    "marked-footnote": "^1.4.0",
    "marked-gfm-heading-id": "^4.1.4",
    "marked-highlight": "^2.2.4",
    "node-emoji": "^2.2.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.2.0",
    "esbuild": "0.28.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
